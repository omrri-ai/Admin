rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Feedbacks collection (for ratings and responses)
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Messages collection (for full chat message history from external assistant)
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Conversations collection and subcollections
    match /conversations/{conversationId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Admin configuration (custom password hash, settings)
    match /admin_config/{configId} {
      allow read, write: if true;
    }
  }
}
